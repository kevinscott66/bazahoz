  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sb.razvedchick.ru; form-action 'none'; base-uri 'none'; frame-ancestors 'none'


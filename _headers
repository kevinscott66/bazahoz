# Заголовки Cloudflare Pages.
#
# no-cache НЕ значит «не кэшировать». Значит «перед выдачей спроси, не изменилось ли».
# Это ровно то, на что рассчитан network-first в sw.js: после выкатки человек с сетью
# получает свежий vahtahoz.html сразу, а кэш остаётся офлайн-резервом.
#
# Без этих строк граница Cloudflare может держать старую оболочку, и выкатка будет
# выглядеть как «правка не доехала». Проверять по заголовку cf-cache-status в ответе.

# Базовая защита для ВСЕХ страниц.
# X-Frame-Options: приложение не должно открываться в чужом iframe — иначе чужой сайт
#   накрывает его прозрачным слоем и палец вахты жмёт «Выйти»/«Удалить» вслепую (clickjacking).
# X-Content-Type-Options: запрет угадывания типа — оболочка отдаётся без расширения,
#   и без этого заголовка браузер может решить исполнить её не так, как задумано.
# Referrer-Policy: не отдаём наружу адрес страницы (в нём бывают идентификаторы базы).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/vahtahoz.html
  Cache-Control: no-cache

/beta/vahtahoz.html
  Cache-Control: no-cache

# Служебный обработчик обязан обновляться сразу: иначе телефоны продолжат отдавать
# старую оболочку из кэша даже после выкатки.
#
# ВНИМАНИЕ: одного этого файла мало. Настройка ЗОНЫ «Browser Cache TTL» перекрывает
# заголовок источника у всего, что Cloudflare кэширует по расширению (.js, .css) —
# .html идёт как DYNAMIC и потому не задет. 02.08.2026 на зоне стояло 14400, и живой
# sw.js отдавался с `max-age=14400`: оболочка после выкатки была новая, а sw.js —
# старый, до четырёх часов. Настройка переведена в 0 = «Respect Existing Headers».
# Если выкатка снова «не доезжает» — сначала посмотреть
# `GET /zones/<id>/settings/browser_cache_ttl`, а не искать беду в _headers.
/sw.js
  Cache-Control: no-cache

/beta/sw.js
  Cache-Control: no-cache

# Номер живой сборки для установленных Android-приложений (см. native/packaged.js).
# Заголовок про источник обязателен: файл лежит на апексе razvedchick.ru, а спрашивает
# его страница с origin https://vahta.razvedchick.ru — без него браузер ответ не отдаст,
# и приложение никогда не узнает, что вышло обновление. Внутри только номер сборки.
/appver.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

# Оболочка лежит без расширения (см. scripts/build-site.sh) — тип задаём явно,
# иначе Pages отдаст её как поток байт и браузер предложит скачать файл.
/vahtahoz
  Content-Type: text/html; charset=utf-8

/beta/vahtahoz
  Content-Type: text/html; charset=utf-8

/vahtahoz.html
  Content-Type: text/html; charset=utf-8

/beta/vahtahoz.html
  Content-Type: text/html; charset=utf-8

# ── Сайт razvedchick.ru ───────────────────────────────────────────────────────
# Политика содержимого задаётся ТОЛЬКО страницам сайта, не приложению: у оболочки
# свой набор встроенных стилей и скриптов, и общий CSP её сломает — это отдельная
# работа с проверкой на живом телефоне.
# Здесь же CSP почти ничего не стоит: страницы статические, единственный внешний
# адрес — функция приёма заявки. 'unsafe-inline' оставлен осознанно (встроенный
# стиль и один скрипт на /start), но сторонние домены для скриптов закрыты —
# именно они и опасны. form-action 'none': ни одна форма никуда не отправляется
# обычным submit, заявка уходит через fetch.
/
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sb.razvedchick.ru; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/index.html
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sb.razvedchick.ru; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/app*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/support*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sb.razvedchick.ru; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/start*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://sb.razvedchick.ru; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/terms*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/privacy*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

# Приложение для Android. Тип задаём явно: без него Pages отдаёт файл как поток байт,
# и часть телефонов открывает его «просмотром» вместо установки. Имя при сохранении —
# с версией, чтобы в «Загрузках» было видно, что именно лежит; раздаётся файл при этом
# по постоянному адресу /vahtahoz.apk (см. scripts/build-site.sh).
/vahtahoz.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="vahtahoz-1.0.7.apk"
  Cache-Control: no-cache

# Один общий файл стилей на все страницы. no-cache, а не длинный срок: имени с
# версией у него нет, и после правки дизайна страница не должна ехать со старым
# оформлением.
/site.css
  Cache-Control: no-cache

.DS_Store
__pycache__/
*.pyc
.env
.env.*
node_modules/
# native/android/ БОЛЬШЕ НЕ ИГНОРИРУЕМ: в MainActivity живёт обработчик скачивания файлов
# (без него экспорт JSON/CSV/XLSX в APK молча не работает), а `npx cap add android` в CI
# каждый раз перетирал бы его свежим шаблоном. Внутри native/android/.gitignore закрывает
# всё генерируемое: build/, .gradle/, local.properties, assets/public, capacitor-cordova-android-plugins.
native/ios/
native-desktop/src-tauri/target/
# gen/ Tauri пересоздаёт при каждой сборке из tauri.conf.json и capabilities/ —
# в репозитории он только шумит в диффе и конфликтует между сборщиками.
native-desktop/src-tauri/gen/

# личные данные: экспорты/бэкапы склада не коммитим в публичный репозиторий.
# Инцидент уже был: vahtahoz-feb2026.json и vahtahoz-spisok.json ~3 месяца лежали в корне
# (= корень GitHub Pages) и отдавались по https://vahta.razvedchick.ru/<имя>.json.
# Приложение генерирует ещё и xlsx/csv — их шаблоны тоже закрываем, а не только .json.
vahtahoz-*.json
vahtahoz-*.xlsx
vahtahoz-*.csv
vahtahoz-*.xls
*.backup.json
# любой файл выгрузки, случайно оставленный в корне
sklad-*.xlsx
sklad-*.csv

# --- Секреты инфраструктуры: НИКОГДА не коммитить реальные токены/ключи ---
# Реальный Cloudflare API-токен живёт только локально (шаблон — cf-token.env.example)
infra/cloudflare/cf-token.env
# Ключи Supabase: PAT для Management API + secret key + пароль БД (шаблон — keys.env.example)
infra/supabase/keys.env
# страховка на случай копий с другими именами/местами (репозиторий публичный)
*keys.env
*-keys.txt
vahtahoz-supabase-keys*
*.secret
# шаблоны *.example коммитим (иначе .env.* выше их бы съел)
!*.example

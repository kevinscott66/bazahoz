# Cloudflare Pages по умолчанию отвечает 308 на /vahtahoz.html и уводит на /vahtahoz.
# Для нас это не косметика: sw.js прекэширует "./vahtahoz.html", а Cache API не принимает
# перенаправленный ответ — install падает, служебный обработчик не встаёт, офлайн-режим
# (весь смысл приложения на вахте) перестаёт работать. Плюс на этот адрес смотрят
# APK, десктоп-обёртка и закладки людей.
# 200 — это перезапись, а не перенаправление: адрес в браузере остаётся прежним.
/vahtahoz.html       /vahtahoz       200
/beta/vahtahoz.html  /beta/vahtahoz  200

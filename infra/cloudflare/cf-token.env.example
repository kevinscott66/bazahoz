# =============================================================================
#  Cloudflare API-токен — ШАБЛОН (этот файл коммитится, БЕЗ реального значения)
# =============================================================================
#  Как пользоваться:
#    1) cp cf-token.env.example cf-token.env
#    2) впишите реальные значения в cf-token.env
#    3) cf-token.env уже в .gitignore — в репозиторий он НЕ попадёт
#
#  Где взять токен:
#    dash.cloudflare.com → My Profile → API Tokens → Create Token → Custom token
#
#  Минимальные права (scopes) для переезда DNS + почты зоны razvedchick.ru:
#    • Zone            → Zone            → Read
#    • Zone            → DNS             → Edit
#    • Zone            → Email Routing Rules → Edit     (если включаем Email Routing)
#    • Account         → Email Routing Addresses → Edit (адреса-получатели, если нужны)
#  Zone Resources: Include → Specific zone → razvedchick.ru
#
#  ВАЖНО: это НЕ Global API Key. Токен — с ограниченными правами и отзываемый.
#  Никогда не вставляйте сюда service_role/Global Key и не коммитьте реальный токен.
# =============================================================================

# API Token (Bearer) для razvedchick.ru
CLOUDFLARE_API_TOKEN=

# ID зоны razvedchick.ru (Cloudflare → зона → Overview, правая колонка «Zone ID»)
CLOUDFLARE_ZONE_ID=

# Account ID (нужен для Email Routing destination addresses)
CLOUDFLARE_ACCOUNT_ID=

# =============================================================================
#  Ключи Supabase — ШАБЛОН (этот файл коммитится, БЕЗ значений)
# =============================================================================
#  Как пользоваться:
#    cp infra/supabase/keys.env.example infra/supabase/keys.env   # реальный файл в .gitignore
#  либо положить на рабочий стол (см. README-команду в конце файла).
#
#  ⚠️  РЕПОЗИТОРИЙ ПУБЛИЧНЫЙ. Ни одно значение ниже (кроме PROJECT_REF и PUBLISHABLE)
#      не должно попасть ни в git, ни в клиентский vahtahoz.html, ни в переписку.
#      Файл с реальными ключами держите вне репозитория и с правами 600.
# =============================================================================

# ── 1. Management API PAT — им применяются миграции (database/query) ─────────
# Это ГЛАВНЫЙ ключ для деплоя SQL. Даёт полный доступ к проекту в обход RLS.
# Где взять: панель Supabase → аватар (правый верх) → Account settings →
#            Access Tokens → Generate new token
# Прямая ссылка: https://supabase.com/dashboard/account/tokens
# Формат: sbp_...
SUPABASE_PAT=

# ── 2. Ref проекта (НЕ секрет — он уже в клиенте) ────────────────────────────
# Виден в URL панели и в vahtahoz.html (CLOUD_CFG.url).
SUPABASE_PROJECT_REF=jzxajxwtcemrztfwbdkm

# ── 3. Secret key (серверный) — для Edge Functions и админских операций ──────
# Заменяет прежний service_role. НИКОГДА не встраивать в клиент: обходит RLS.
# Где взять: Project → Settings → API Keys → секция Secret keys → Reveal
# Прямая ссылка: https://supabase.com/dashboard/project/jzxajxwtcemrztfwbdkm/settings/api-keys
# Формат: sb_secret_...
SUPABASE_SECRET_KEY=

# ── 4. Publishable key (ПУБЛИЧНЫЙ, для справки) ──────────────────────────────
# Уже вшит в клиент и это нормально: данные защищает RLS, а не секретность ключа.
# Здесь только чтобы не путать его с secret. Значение см. в vahtahoz.html.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UxWs9yx1r4fbo4KJJZqYLA_ndNyVgT0

# ── 5. Пароль базы (для бэкапов pg_dump вне сервера) ────────────────────────
# Понадобится для задачи «бэкапы вне единственного хоста».
# Где взять: Project → Settings → Database → Connection string / Reset password
# Прямая ссылка: https://supabase.com/dashboard/project/jzxajxwtcemrztfwbdkm/settings/database
SUPABASE_DB_PASSWORD=

# =============================================================================
#  Проверка PAT (после заполнения):
#    set -a && . ./keys.env && set +a
#    curl -s -H "Authorization: Bearer $SUPABASE_PAT" \
#      https://api.supabase.com/v1/projects | head -40
#
#  Применить миграцию (крупные — чанками, целиком иногда даёт 502):
#    curl -s -X POST \
#      "https://api.supabase.com/v1/projects/$SUPABASE_PROJECT_REF/database/query" \
#      -H "Authorization: Bearer $SUPABASE_PAT" \
#      -H "Content-Type: application/json" \
#      --data-binary @<(jq -Rs '{query:.}' < supabase/migrations/ФАЙЛ.sql)
#
#  Положить на рабочий стол с правильными правами:
#    cp infra/supabase/keys.env.example ~/Desktop/vahtahoz-supabase-keys.env
#    chmod 600 ~/Desktop/vahtahoz-supabase-keys.env
# =============================================================================
